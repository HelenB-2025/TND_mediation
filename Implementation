####NIE
cNIE_sandwich <- function(data,model.out,model.med,model.ps,newdata) {
  
  ## 1) Fit the three logistic models
  # beta: P(M=1 | V, L)
  fit_M  <- glm(as.formula(model.med),  family = binomial(), data = data)
  beta_hat <- coef(fit_M)
  
  # gamma: P(V=1 | L)
  fit_V <- glm(as.formula(model.ps), family = binomial(), data = data)
  gamma_hat <- coef(fit_V)
  
  # eta: P(V=1 | L, C=1)
  fit_VC <- glm(as.formula(model.ps), family = binomial(), data = data, subset = (C == 1))
  eta_hat <- coef(fit_VC)
  
  ## 2) Build design rows at L=l using your global 1-row newdat
  newdata <- as.data.frame(newdata)  
  
  # --- X2 rows for mediator model: V=1 and V=0 
  trm2_full <- terms(fit_M)
  trm2_rhs  <- delete.response(trm2_full)
  xlev2     <- fit_M$xlevels
  
  nd2_1 <- newdata; nd2_1$V <- 1
  nd2_0 <- newdata; nd2_0$V <- 0
  
  mf2_1 <- model.frame(trm2_rhs, data = nd2_1, xlev = xlev2, na.action = na.pass)
  mf2_0 <- model.frame(trm2_rhs, data = nd2_0, xlev = xlev2, na.action = na.pass)
  X2_1  <- model.matrix(trm2_rhs, data = mf2_1)  # (1 x p_beta)
  X2_0  <- model.matrix(trm2_rhs, data = mf2_0)
  
  # --- X3 row for V models
  trm3_full <- terms(fit_V)
  trm3_rhs  <- delete.response(trm3_full)
  xlev3     <- fit_V$xlevels
  
  mf3 <- model.frame(trm3_rhs, data = newdata, xlev = xlev3, na.action = na.pass)
  X3  <- model.matrix(trm3_rhs, data = mf3)      # (1 x p_gamma)
  
  # for eta model, use its own terms/levels (in case factors differ)
  trm4_full <- terms(fit_VC)
  trm4_rhs  <- delete.response(trm4_full)
  xlev4     <- fit_VC$xlevels
  
  mf4 <- model.frame(trm4_rhs, data = newdata, xlev = xlev4, na.action = na.pass)
  X3e <- model.matrix(trm4_rhs, data = mf4)      # (1 x p_eta)
  
  ## 3) Compute lambda2_hat
  # A = expit(X2_1 beta) / expit(X2_0 beta)
  m1 <- expit(drop(X2_1 %*% beta_hat))
  m0 <- expit(drop(X2_0 %*% beta_hat))
  A  <- as.numeric(m1 / m0)
  
  # B = expit(X3 gamma) / (1 - expit(X3 gamma))  
  vW <- expit(drop(X3 %*% gamma_hat))
  B  <- as.numeric(vW / (1 - vW))
  
  # C = (1 - expit(X3 eta)) / expit(X3 eta) = 1 / odds under C=1
  vC <- expit(drop(X3 %*% eta_hat))
  Cc <- as.numeric((1 - vC) / vC)
  
  lambda2_hat <- A * B * Cc
  
  ## 4) Delta-method gradients
  
  # Gradient w.r.t beta (through A only)
  dm1 <- as.numeric(m1 * (1 - m1)) * as.numeric(X2_1)/as.numeric(m0)
  dm0 <- as.numeric(m1 * (1 - m0)) * as.numeric(X2_0)/as.numeric(m0)
  dA_dbeta <- dm1-dm0  # length p_beta
  grad_beta <- (B * Cc) * dA_dbeta
  
  # Gradient w.r.t gamma (through B only)
  # B = v/(1-v) ; dB/dγ = v/(1-v) * X = B * X
  dB_dgamma <- as.numeric(B) * as.numeric(X3)   # length p_gamma
  grad_gamma <- (A * Cc) * dB_dgamma
  
  # Gradient w.r.t eta (through Cc only)
  # Cc = (1-v)/v = 1/v - 1 ; dCc/dη = -(1/v^2) * dv/dη
  # dv/dη = v(1-v) X
  dvC <- as.numeric(vC * (1 - vC)) * as.numeric(X3e)
  #dCc_deta <- -exp(-vC** as.numeric(X3e))* as.numeric(X3e)
  dCc_deta <- -Cc * as.numeric(X3e)
  grad_eta <- (A * B) * dCc_deta
  
  # stacked gradient
  grad <- c(grad_beta, grad_gamma, grad_eta)
  
  
  ###################################################
  ###variance-covariance matrix from stacked score functions
  # 2) Build design matrices on the full dataset (factor-safe)
  # X2 for beta model
  mf2 <- model.frame(trm2_rhs, data = data, xlev = fit_M$xlevels, na.action = na.pass)
  X2  <- model.matrix(trm2_rhs, data = mf2)
  M   <- model.response(model.frame(fit_M, data = data, na.action = na.pass))
  
  # X3 for gamma model
  mf3 <- model.frame(trm3_rhs, data = data, xlev = fit_V$xlevels, na.action = na.pass)
  X3  <- model.matrix(trm3_rhs, data = mf3)
  V   <- model.response(model.frame(fit_V, data = data, na.action = na.pass))
  
  # X3e for eta model (may differ due to factor levels / contrasts)
  trm4_rhs <- delete.response(terms(fit_VC))
  mf4 <- model.frame(trm4_rhs, data = data, xlev = fit_VC$xlevels, na.action = na.pass)
  X3e <- model.matrix(trm4_rhs, data = mf4)
  
  # 3) Fitted probabilities (working models)
  e2 <- expit(drop(X2  %*% beta_hat))   # P(M=1 | V,L)
  e3 <- expit(drop(X3  %*% gamma_hat))  # P(V=1 | L)
  e4 <- expit(drop(X3e %*% eta_hat))    # P(V=1 | L, C=1)  (fit among C=1)
  
  indC <- as.numeric(data$C == 1)
  n <- nrow(data)
  # 4) Per-observation estimating functions psi_i (stacked)
  psi_beta  <- (M - e2) * X2
  psi_gamma <- (V - e3) * X3
  psi_eta   <- (indC * (V - e4)) * X3e
  
  psi_stack <- cbind(psi_beta, psi_gamma, psi_eta)  # n x p_total
  
  # 5) B (meat): (1/n) Σ psi_i psi_i^T
  B_hat <- crossprod(psi_stack) / n
  
  # 6) A (bread): (1/n) Σ ∂psi_i/∂theta^T
  # For logistic score: ∂/∂θ [X(y-p)] = - X X^T p(1-p)
  w2 <- e2 * (1 - e2)
  w3 <- e3 * (1 - e3)
  w4 <- indC * e4 * (1 - e4)
  
  A_beta  <- -crossprod(X2,  X2  * w2) / n
  A_gamma <- -crossprod(X3,  X3  * w3) / n
  A_eta   <- -crossprod(X3e, X3e * w4) / n
  
  pB <- ncol(X2); pG <- ncol(X3); pE <- ncol(X3e)
  A_hat <- matrix(0, nrow = pB + pG + pE, ncol = pB + pG + pE)
  A_hat[1:pB, 1:pB] <- A_beta
  A_hat[(pB+1):(pB+pG), (pB+1):(pB+pG)] <- A_gamma
  A_hat[(pB+pG+1):(pB+pG+pE), (pB+pG+1):(pB+pG+pE)] <- A_eta
  
  # 7) Sandwich covariance: Var(theta_hat) = A^{-1} B A^{-T} / n
  A_inv <- solve(A_hat)
  V_hat <- (A_inv %*% B_hat %*% t(A_inv)) / n
  ###############################################
  
  
  # full delta-method variance with cross-covariances
  var_lambda2 <- as.numeric(t(grad) %*% V_hat %*% grad)
  se_lambda2  <- sqrt(var_lambda2)
  
  list(
    lambda2_hat = lambda2_hat,
    se_lambda2  = se_lambda2,
    var_lambda2 = var_lambda2
  )
}



#cTE
cTE_sandwich <- function(data, model.out, model.med, model.ps, newdata) {
  expit <- function(x) plogis(x)
  
  data <- as.data.frame(data)
  newdata <- as.data.frame(newdata)
  
  if (nrow(newdata) != 1L) {
    stop("newdata must contain exactly one covariate profile (one row).")
  }
  if (!all(c("M", "V", "C") %in% names(data))) {
    stop("data must contain variables named M, V, and C.")
  }
  
  ## 1. Fit all working models
  fit_Y  <- glm(as.formula(model.out), family = binomial(), data = data)
  fit_M  <- glm(as.formula(model.med), family = binomial(), data = data)
  fit_V  <- glm(as.formula(model.ps),  family = binomial(), data = data)
  fit_VC <- glm(as.formula(model.ps),  family = binomial(), data = data,
                subset = (C == 1))
  
  alpha <- coef(fit_Y)
  beta  <- coef(fit_M)
  gamma <- coef(fit_V)
  eta   <- coef(fit_VC)
  
  if (anyNA(c(alpha, beta, gamma, eta))) {
    stop("At least one fitted model has non-estimable coefficients.")
  }
  
  ## Helper: construct a model matrix using a fitted model's terms/levels
  mm <- function(fit, d) {
    rhs <- delete.response(terms(fit))
    mf <- model.frame(rhs, data = d, xlev = fit$xlevels,
                      na.action = na.pass)
    model.matrix(rhs, data = mf, contrasts.arg = fit$contrasts)
  }
  
  ## 2. cNDE and its gradient with respect to alpha
  # As in the supplied cNDE function, evaluate Y at M=1 and compare V=1 vs V=0.
  nd_y1 <- newdata
  nd_y0 <- newdata
  nd_y1$M <- nd_y0$M <- 1
  nd_y1$V <- 1
  nd_y0$V <- 0
  
  x_y1 <- mm(fit_Y, nd_y1)
  x_y0 <- mm(fit_Y, nd_y0)
  y1 <- expit(drop(x_y1 %*% alpha))
  y0 <- expit(drop(x_y0 %*% alpha))
  cNDE_hat <- as.numeric(y1 / y0)
  
  # d log(y1/y0)/d alpha = (1-y1)x_y1 - (1-y0)x_y0
  grad_nde_alpha <- cNDE_hat *
    ((1 - y1) * as.numeric(x_y1) -
       (1 - y0) * as.numeric(x_y0))
  
  ## 3. cNIE and gradients with respect to beta, gamma, and eta
  nd_m1 <- newdata
  nd_m0 <- newdata
  nd_m1$V <- 1
  nd_m0$V <- 0
  
  x_m1 <- mm(fit_M, nd_m1)
  x_m0 <- mm(fit_M, nd_m0)
  x_v  <- mm(fit_V,  newdata)
  x_vc <- mm(fit_VC, newdata)
  
  m1 <- expit(drop(x_m1 %*% beta))
  m0 <- expit(drop(x_m0 %*% beta))
  pv <- expit(drop(x_v %*% gamma))
  pc <- expit(drop(x_vc %*% eta))
  
  med_ratio <- as.numeric(m1 / m0)
  odds_v    <- as.numeric(pv / (1 - pv))
  inv_odds_c <- as.numeric((1 - pc) / pc)
  cNIE_hat <- med_ratio * odds_v * inv_odds_c
  
  # Log-gradient form gives compact, stable product-rule derivatives.
  grad_nie_beta <- cNIE_hat *
    ((1 - m1) * as.numeric(x_m1) -
       (1 - m0) * as.numeric(x_m0))
  grad_nie_gamma <- cNIE_hat * as.numeric(x_v)
  grad_nie_eta   <- -cNIE_hat * as.numeric(x_vc)
  
  ## 4. Gradient of cTE = cNDE*cNIE for theta=(alpha,beta,gamma,eta)
  cTE_hat <- cNDE_hat * cNIE_hat
  grad_te <- c(
    cNIE_hat * grad_nde_alpha,
    cNDE_hat * grad_nie_beta,
    cNDE_hat * grad_nie_gamma,
    cNDE_hat * grad_nie_eta
  )
  
  ## 5. Joint stacked estimating functions
  # Requiring complete data keeps every score row aligned. If the supplied GLMs
  # use different analysis samples, a joint observation-level sandwich needs an
  # explicit missing-data convention instead.
  needed <- unique(c(all.vars(as.formula(model.out)),
                     all.vars(as.formula(model.med)),
                     all.vars(as.formula(model.ps)), "C"))
  if (anyNA(data[, needed, drop = FALSE])) {
    stop(paste0(
      "Variables used by the models contain missing values. Supply a common ",
      "complete-case data set before calling cTE_sandwich()."
    ))
  }
  
  X_y  <- mm(fit_Y,  data)
  X_m  <- mm(fit_M,  data)
  X_v  <- mm(fit_V,  data)
  X_vc <- mm(fit_VC, data)
  
  Y <- model.response(model.frame(fit_Y, data = data,
                                  na.action = na.pass))
  M <- model.response(model.frame(fit_M, data = data,
                                  na.action = na.pass))
  V <- model.response(model.frame(fit_V, data = data,
                                  na.action = na.pass))
  
  py <- expit(drop(X_y %*% alpha))
  pm <- expit(drop(X_m %*% beta))
  pv_all <- expit(drop(X_v %*% gamma))
  pc_all <- expit(drop(X_vc %*% eta))
  ind_c <- as.numeric(data$C == 1)
  
  psi_alpha <- (Y - py) * X_y
  psi_beta  <- (M - pm) * X_m
  psi_gamma <- (V - pv_all) * X_v
  psi_eta   <- ind_c * (V - pc_all) * X_vc
  psi <- cbind(psi_alpha, psi_beta, psi_gamma, psi_eta)
  
  n <- nrow(data)
  meat <- crossprod(psi) / n
  
  bread_alpha <- -crossprod(X_y,  X_y  * (py * (1 - py))) / n
  bread_beta  <- -crossprod(X_m,  X_m  * (pm * (1 - pm))) / n
  bread_gamma <- -crossprod(X_v,  X_v  * (pv_all * (1 - pv_all))) / n
  bread_eta   <- -crossprod(X_vc, X_vc *
                              (ind_c * pc_all * (1 - pc_all))) / n
  
  dims <- c(ncol(X_y), ncol(X_m), ncol(X_v), ncol(X_vc))
  ends <- cumsum(dims)
  starts <- c(1L, head(ends, -1L) + 1L)
  bread <- matrix(0, sum(dims), sum(dims))
  blocks <- list(bread_alpha, bread_beta, bread_gamma, bread_eta)
  for (j in seq_along(blocks)) {
    bread[starts[j]:ends[j], starts[j]:ends[j]] <- blocks[[j]]
  }
  
  bread_inv <- solve(bread)
  vcov_theta <- bread_inv %*% meat %*% t(bread_inv) / n
  
  ## 6. Delta-method sandwich variance
  var_cTE <- as.numeric(crossprod(grad_te, vcov_theta %*% grad_te))
  # Guard only against negligible negative round-off.
  if (var_cTE < 0 && var_cTE > -sqrt(.Machine$double.eps)) var_cTE <- 0
  se_cTE <- sqrt(var_cTE)
  
  list(
    cTE_hat = cTE_hat,
    #se_cTE = se_cTE,
    var_cTE = var_cTE,
    cNDE_hat = cNDE_hat,
    cNIE_hat = cNIE_hat
    #vcov_theta = vcov_theta,
    #gradient_cTE = grad_te
  )
}


