

#TND data should be prepared as: only contain TND sample and only contain id variable, outcome variable, 
#treatment variable, mediator variable, control indicator variable and all the confounder to be adjusted.

#Parameters used in the function:
  #data: name of dataset
  #id: variable name for ID, if there is multiple observations from one individual.
  #control.ind: indicator variable name for TND control with indicator=1 or case with indicator=0, e.g.control.ind=C.
  #mediator: variable name of the mediator which must be a binary variable, e.g, mediator=Mediator.
  #trt: variable name of mediator which must be a binary variable, e.g, trt=Vaccine.
  #outcome: variable name of outcome which must be a binary variable, e.g, outcome=Y.
  #model.out: specify outcome model e.g.model.out="Y~M+V+L1+L2+L3+as.factor(L4)".
  #model.med: specify mediator model e.g.model.med="M~V+L1+L2+L3+as.factor(L4)".
  #model.ps: specify propensity score model e.g.model.ps="V~L1+L2+L3+as.factor(L4)".

#[IMPORTANT!] fix.val: specify confounder values for prediction, the order should follow the order of confounder,
  #listed in the input dataset, rather than the order listed in the model. 
  #If NULL, the mean values of continuous confounder and mode of categorical variable will be used.  e.g.,fix.val=c(1,0,1,"Low") 
  #boots: specify the number of iteration for bootstrap variance estimate.


library(Matrix)
library(dplyr)
library(LaplacesDemon)


#################Function#####################
set.seed(100)
med.est<-function(data,id,control.ind,mediator,trt,outcome,model.out,model.med,model.ps,fix.val=NULL,boots=0){
  
  #rename variables
  names(data)[names(data) == outcome] <- "Y"
  names(data)[names(data) == trt] <- "V"
  names(data)[names(data) == mediator] <- "M"
  names(data)[names(data) == control.ind] <- "C"
  names(data)[names(data) == id] <- "id"
  
  #extract categorical variables
  extract_factor_vars <- function(formula_obj) {
    # Convert formula to character
    form_char <- paste(deparse(formula_obj), collapse = "")
    
    # Find matches
    m <- gregexpr("as\\.factor\\s*\\(([^)]+)\\)", form_char)
    matches <- regmatches(form_char, m)[[1]]
    
    # Extract variable names
    vars <- sub("as\\.factor\\s*\\(([^)]+)\\)", "\\1", matches)
    return(vars)
  }
  
  factor.out<-extract_factor_vars(model.out)
  factor.med<-extract_factor_vars(model.med)
  factor.ps<-extract_factor_vars(model.ps)
  
  #factorize the variables in the data
  factorize_from_formula <- function(data, formula_obj) {
    vars <- extract_factor_vars(formula_obj)
    for (v in vars) {
      if (v %in% names(data)) {
        data[[v]] <- factor(data[[v]])
      } else {
        warning(paste("Variable", v, "not found in data"))
      }
    }
    data[["id"]] <- NULL
    return(data)
  }
  
  dat.out<-factorize_from_formula(data,model.out)
  dat.med<-extract_factor_vars(model.med)
  dat.ps<-extract_factor_vars(model.ps)
  
  #factor categorical variable and set the default value to its mode
  add_factor_columns_mode <- function(newdat, data, factor_vars) {
    for (v in factor_vars) {
      if (v %in% names(data)) {
        x <- factor(data[[v]])
        levs <- levels(x)
        
        if (all(is.na(x))) {
          mode_value <- NA_character_
        } else {
          counts <- table(x)
          mode_value <- names(counts)[which.max(counts)]
        }
        
        newdat[[v]] <- factor(
          rep(mode_value, nrow(newdat)),
          levels = levs
        )
      } else {
        warning(paste("Variable", v, "not found in data"))
      }
    }
    
    return(newdat)
  }
  
  #whether to calculate conditional effects for pre-specified confounder values
  if(is.null(fix.val)){
    #assign mean values to continuous confounder
    vars <- names(dplyr::select(data, !c(C,V,M,Y,id)&!factor.out))
    mean_values <- colMeans(data[, vars], na.rm = TRUE)
    var_value <- as.data.frame(t(mean_values)) 
    newdat <- add_factor_columns_mode(var_value, data, factor.out)
  }else{
    #assign pre-specified values to each confounder
    vars.all <- names(dplyr::select(data, !c(C,V,M,Y,id)))
    var_value <-as.data.frame(as.list(setNames(fix.val, vars.all)))
    #for (v in factor.out) {
    #  var_value[[v]] <- factor(
    #    as.character(var_value[[v]]),
    #    levels = levels(data[[v]]))
    #}
    # variables that should be numeric (all except factor variables)
    num_vars <- setdiff(names(var_value), factor.out)
    # convert them to numeric
    var_value[num_vars] <- lapply(var_value[num_vars], function(x) as.numeric(as.character(x)))
    newdat<-var_value
  }
  
  
  #######TND Estimators#########
  #cNDE
  #logistic regression for outcome model P(Y=1|M,V,L,W)
  outcome.formula <- as.formula(model.out)
  out.model<-glm(outcome.formula,data=data,family="binomial"(link = "logit"))
  pred1<-predict(out.model,newdata=data.frame(V=1,M=1,newdat),type="response")
  pred0<-predict(out.model,newdata=data.frame(V=0,M=1,newdat),type="response")
  cNDE<-pred1/pred0
    
  #cNIE
  #logistic regression for mediator model P(M=1|V,L,W)
  mediator.model<-glm(model.med,data=data,family="binomial"(link = "logit"))
  mpred1<-predict(mediator.model,newdata=data.frame(V=1,newdat),type="response")
  mpred0<-predict(mediator.model,newdata=data.frame(V=0,newdat),type="response")
  cNIE.TND<-mpred1/mpred0
  #ps ratio
  ps.model<-glm(model.ps,data=data,family="binomial"(link = "logit"))
  vpred<-predict(ps.model,newdata=newdat,type="response")
  ratio.ps<-vpred/(1-vpred)
  #control
  TND.c<-subset(data,data$C==1)
  ps.c.model<-glm(model.ps,data=TND.c,family="binomial"(link = "logit"))
  ps.c.pred<-predict(ps.c.model,newdata=newdat,type="response")
  ratio.ps.c<-ps.c.pred/(1-ps.c.pred)
  cNIE<-cNIE.TND*ratio.ps/ratio.ps.c
  
  #cTE
  cTE<-cNIE*cNDE
  
  #cCDE on OR
  cCDE<-(pred1/(1-pred1))/(pred0/(1-pred0))
  
  #bootstrap variance
  cNDE.var<-rep(0,boots);cNIE.var<-rep(0,boots);cTE.var<-rep(0,boots);cCDE.var<-rep(0,boots)
  
  for (j in 1:boots){
    sample_id<-sample(unique(data$id),length(unique(data$id)),replace=TRUE)
    s.dat <- data[
      data$id %in% sample_id,
      ,
      drop = FALSE
    ]
    #cNDE
    #logistic regression for outcome model P(Y=1|M,V,L,W)
    outcome.formula <- as.formula(model.out)
    out.model<-glm(outcome.formula,data=s.dat,family="binomial"(link = "logit"))
    pred1<-predict(out.model,newdata=data.frame(V=1,M=1,newdat),type="response")
    pred0<-predict(out.model,newdata=data.frame(V=0,M=1,newdat),type="response")
    cNDE.var[j]<-pred1/pred0
    
    #cNIE
    #logistic regression for mediator model P(M=1|V,L,W)
    mediator.model<-glm(model.med,data=s.dat,family="binomial"(link = "logit"))
    mpred1<-predict(mediator.model,newdata=data.frame(V=1,newdat),type="response")
    mpred0<-predict(mediator.model,newdata=data.frame(V=0,newdat),type="response")
    cNIE.TND<-mpred1/mpred0
    #ps ratio
    ps.model<-glm(model.ps,data=s.dat,family="binomial"(link = "logit"))
    vpred<-predict(ps.model,newdata=newdat,type="response")
    ratio.ps<-vpred/(1-vpred)
    #control
    TND.c<-subset(s.dat,s.dat$C==1)
    ps.c.model<-glm(model.ps,data=TND.c,family="binomial"(link = "logit"))
    ps.c.pred<-predict(ps.c.model,newdata=newdat,type="response")
    ratio.ps.c<-ps.c.pred/(1-ps.c.pred)
    cNIE.var[j]<-cNIE.TND*ratio.ps/ratio.ps.c
    
    #cTE
    cTE.var[j]<-cNIE.var[j]*cNDE.var[j]
    
    #cCDE on OR
    cCDE.var[j]<-(pred1/(1-pred1))/(pred0/(1-pred0))
  } 
  
  boots.cNDE<-var(cNDE.var)
  boots.cNIE<-var(cNIE.var)
  boots.cTE<-var(cTE.var)
  boots.cCDE<-var(cCDE.var)
  #bootstrap 95% percentile
  cNDE.l<-quantile(cNDE.var, probs = 0.025);cNDE.u<-quantile(cNDE.var, probs = 0.975)
  cNIE.l<-quantile(cNIE.var, probs = 0.025);cNIE.u<-quantile(cNIE.var, probs = 0.975)
  cTE.l<-quantile(cTE.var, probs = 0.025);cTE.u<-quantile(cTE.var, probs = 0.975)
  cCDE.l<-quantile(cCDE.var, probs = 0.025);cCDE.u<-quantile(cCDE.var, probs = 0.975)
  
  #sandwich variance
  #cNDE
  cNDE.sand <- cNDE_sandwich(data,model.out,model.med,newdat)
  
  cNIE.sand <- cNIE_sandwich(data,model.out,model.med,model.ps,newdat)
  
  cTE.sand <- cTE_sandwich(data,model.out,model.med,model.ps,newdat)
  
  out<-list("cNDE"=cNDE,"cNIE"=cNIE,"cTE"=cTE,"cCDE"=cCDE,
            "boots.cNDE"=boots.cNDE,"boots.cNIE"=boots.cNIE,"boots.cTE"=boots.cTE,"boots.cCDE"=boots.cCDE,
            "sand.cNDE"=cNDE.sand$var_lambda,"sand.cNIE"=cNIE.sand$var_lambda2,
            "sand.cTE"=cTE.sand$var_cTE,
            "cNDE.l"=cNDE.l,"cNDE.u"=cNDE.u,
            "cNIE.l"=cNIE.l,"cNIE.u"=cNIE.u,
            "cTE.l"=cTE.l,"cTE.u"=cTE.u,
            "cCDE.l"=cCDE.l,"cCDE.u"=cCDE.u,"value"=newdat)
  return(out)
}




#########sandwich estimator function##########
###cNDE
expit <- function(x) 1/(1 + exp(-x))

cNDE_sandwich <- function(data,model.out,model.med,newdata) {
  
  # 1) Fit logistic model
  fit <- glm(as.formula(model.out), family = binomial(), data = data)
  alpha_hat <- coef(fit)
  
  # --- KEY FIX: use RHS-only terms for newdata matrices ---
  trm_full <- terms(fit)                 # includes response
  trm_rhs  <- delete.response(trm_full)  # RHS only
  rhs_vars <- all.vars(trm_rhs)
  xlev     <- fit$xlevels
  
  newdata<-as.data.frame(newdata) 
  newdata$M<-1
  newdata$V<-0
  
  # create nd1 (V=1) and nd0 (V=0)
  nd1 <- newdata
  nd0 <- newdata
  nd1$V <- 1
  nd0$V <- 0
  
  # model matrices for the two design vectors
  mf1 <- model.frame(trm_rhs, data = nd1, xlev = xlev, na.action = na.pass)
  mf0 <- model.frame(trm_rhs, data = nd0, xlev = xlev, na.action = na.pass)
  x1  <- model.matrix(trm_rhs, data = mf1)
  x0  <- model.matrix(trm_rhs, data = mf0)
  
  # 4) lambda_hat
  eta1 <- drop(x1 %*% alpha_hat)
  eta0 <- drop(x0 %*% alpha_hat)
  p1 <- expit(eta1)
  p0 <- expit(eta0)
  lambda_hat <- as.numeric(p1 / p0)
  
  # 5) gradient d lambda / d alpha
  dp1 <- as.numeric(p1 * (1 - p1)) * as.numeric(x1)
  dp0 <- as.numeric(p0 * (1 - p0)) * as.numeric(x0)
  grad <- (dp1 / p0) - (p1 / (p0^2)) * dp0
  
  #######################################
  n <- nrow(data)
  # 2) Sandwich variance for alpha_hat
  #V_alpha<-sandwich::vcovHC(fit, type = vcov_type)
  mf_rhs  <- model.frame(trm_rhs, data = data, xlev = fit$xlevels, na.action = na.pass)
  X1 <- model.matrix(trm_rhs, data = mf_rhs)
  Y  <- model.response(model.frame(fit, data = data, na.action = na.pass))
  
  # 3) Predicted probabilities
  e1 <- expit(drop(X1 %*% alpha_hat))
  
  # 5) Per-observation ψ_{α,i} (n x p)
  psi_alpha <- (Y - e1) * X1
  
  # 6) Meat B = (1/n) Σ ψ_i ψ_i^T
  B_hat <- crossprod(psi_alpha) / n
  
  # 7) Bread A = (1/n) Σ ∂ψ_i/∂α^T = -(1/n) Σ indW * e(1-e) X X^T
  w <-  e1 * (1 - e1)
  A_hat <- -crossprod(X1, X1 * w) / n
  
  # 8) Sandwich vcov: Var(alpha_hat) = A^{-1} B A^{-T} / n
  A_inv <- solve(A_hat)
  V_alpha <- (A_inv %*% B_hat %*% t(A_inv)) / n
  #######################################
  
  # 6) delta-method sandwich variance for lambda
  var_lambda <- as.numeric(t(grad) %*% V_alpha %*% grad)
  se_lambda  <- sqrt(var_lambda)
  
  list(lambda_hat = lambda_hat, se_lambda = se_lambda, var_lambda = var_lambda)
}




