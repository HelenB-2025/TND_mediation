set.seed(100)
data.gen.post.rand<-function(popsize=1000000){
  ####1st timepoint
  #Confounder
  L1<-rbern(popsize,0.5)         
  L2<-runif(popsize,0,1)
  L3<-rbern(popsize,0.4)
  
  V=rbinom(prob=plogis(0.8+0.3*L1+0.3*L2),size=1,n=popsize) 
  
  #other infection
  I0<-rep(0,popsize)
  I0<-rbinom(prob=plogis(0.2*L1+0.2*L3-3), 
             size=1,n=popsize)        
  
  #potential COVID infection
  I1_1<-rep(0,popsize);I1_0<-rep(0,popsize)
  I1_1<-rbinom(prob=plogis(log(OR1_I1)+0.2*L1+0.2*L3-2.5), 
               size=1,n=popsize)        
  I1_0<-rbinom(prob=plogis(0.2*L1+0.2*L3-2.5), 
               size=1,n=popsize)        
  #observed COVID infection
  I1=rep(0,popsize)                                        
  I1[V==0]<-I1_0[V==0]                  
  I1[V==1]<-I1_1[V==1]                  
  
  
  #symptom caused by other pathogen
  W0=rep(0,popsize);
  W0[I0==1]<-rbinom(prob=plogis(-2+0.1*L1[I0==1]+0.1*L3[I0==1])
                    ,size=1, n=sum(I0==1))  
  
  #symptom caused by COVID
  #potential symptom
  W1_1=rep(0,popsize);W1_0=rep(0,popsize);W1=rep(0,popsize);
  W1_1[I1_1==1]<-rbinom(prob=plogis(-1+0.3*L1[I1_1==1]+0.2*L3[I1_1==1]+log(OR1_W1))
                        ,size=1,n=sum(I1_1==1))   
  W1_0[I1_0==1]<-rbinom(prob=plogis(-1+0.3*L1[I1_0==1]+0.2*L3[I1_0==1])
                        ,size=1,n=sum(I1_0==1))   
  #observed symptom
  W1[V==1]<- W1_1[V==1]    
  W1[V==0]<- W1_0[V==0]    
  
  #COVID-like symptom
  W_1=rep(0,popsize);W_0=rep(0,popsize);W=rep(0,popsize);
  W_1<-ifelse((W0==1|W1_1==1),1,0) 
  W_0<-ifelse((W0==1|W1_0==1),1,0)
  W<-ifelse((W0==1|W1==1),1,0)
  
  
  #Hospitalization/Tested, random samples from COVID-like symptom population
  H=rep(0,popsize);H_1=rep(0,popsize);H_0=rep(0,popsize);
  H_1[W_1==1]<-rbinom(prob=plogis(0.5)
                      ,size=1, n=sum(W_1==1))
  H_0[W_0==1]<-rbinom(prob=plogis(0.5)
                      ,size=1, n=sum(W_0==1))
  H[V==1]<-H_1[V==1]
  H[V==0]<-H_0[V==0]
  
  
  ####long-COVID requires first infection and COVID symptom
  Y<-rep(0,popsize);
  Y1_M1<-rep(0,popsize);Y0_M1<-rep(0,popsize);
  Y1_M0<-rep(0,popsize);Y0_M0<-rep(0,popsize);
  Y1_1<-rep(0,popsize);Y0_1<-rep(0,popsize)
  #potential outcome
  Y1_M1[W1_1==1]<-rbinom(prob=plogis(0.2*L2[W1_1==1]+0.2*L3[W1_1==1]+log(OR1_Y)+
                                       0.2*W1_1[W1_1==1]),size=1,n=sum(W1_1==1))         
  Y1_M0[W1_0==1]<-rbinom(prob=plogis(0.2*L2[W1_0==1]+0.2*L3[W1_0==1]+log(OR1_Y)+
                                       0.2*W1_0[W1_0==1]),size=1,n=sum(W1_0==1))    
  
  Y0_M1[W1_1==1]<-rbinom(prob=plogis(0.2*L2[W1_1==1]+0.2*L3[W1_1==1]+0.2*W1_1[W1_1==1]),
                         size=1,n=sum(W1_1==1))
  Y0_M0[W1_0==1]<-rbinom(prob=plogis(0.2*L2[W1_0==1]+0.2*L3[W1_0==1]+0.2*W1_0[W1_0==1]),  
                         size=1,n=sum(W1_0==1))     
  
  Y1_1<-rbinom(prob=plogis(0.2*L2+0.2*L3+log(OR1_Y)+0.2),
               size=1,n=popsize)
  Y0_1<-rbinom(prob=plogis(0.2*L2+0.2*L3+0.2),
               size=1,n=popsize)
  #observed outcome
  Y[V==0]<-Y0_M0[V==0]                
  Y[V==1]<-Y1_M1[V==1]                
  
  
  ID=seq(1:popsize)
  dat<-data.frame(ID,L1,L2,L3,V,I0,I1,I1_0,I1_1,W,W_1,W_0,W0,W1,W1_1,W1_0,H,H_1,H_0,Y,Y0_M0,Y0_M1,Y1_M0,Y1_M1,Y1_1,Y0_1)
  
  return(dat)
}




